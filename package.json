{
  "name": "pdf-tanpa-kunci",
  "version": "1.0.0",
  "description": "Aplikasi desktop untuk membuat salinan PDF tanpa permintaan password.",
  "main": "electron/main.js",
  "author": "Kikyarfi",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --universal"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.kikyarfi.pdftanpakunci",
    "productName": "PDF Tanpa Kunci",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "app-ui",
        "filter": [
          "index.html",
          "app.js",
          "favicon.svg",
          "qpdf.js",
          "qpdf.wasm",
          "assets/**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "target": ["dmg"]
    },
    "win": {
      "icon": "build/icon.png",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
